<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_baked" colorspace="srgb_texture">
    <image name="base_color" type="color3">
      <input name="file" type="filename" value="Marble_3D_gltf_pbr_base_color.png" />
