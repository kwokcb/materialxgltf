  </gltf_anisotropy_image>
  <!-- Generated shader: Lamp_Filament -->
  <gltf_pbr name="Lamp_Filament" type="surfaceshader" nodedef="ND_gltf_pbr_surfaceshader">
    <input name="base_color" type="color3" value="0.09, 0.09, 0.09" colorspace="lin_rec709" />
    <input name="alpha" type="float" value="1" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.7" />
    <input name="emissive" type="color3" value="1, 0.5, 0.25" colorspace="lin_rec709" />
    <input name="emissive_strength" type="float" value="25" />
  </gltf_pbr>
  <!-- Generated material: MAT_Lamp_Filament -->
  <surfacematerial name="MAT_Lamp_Filament" type="material">
