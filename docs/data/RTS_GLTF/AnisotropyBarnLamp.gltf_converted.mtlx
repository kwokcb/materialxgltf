    <input name="anisotropy_strength" type="float" nodename="image_anisotropy_strength" output="anisotropy_strength_out" />
    <input name="anisotropy_rotation" type="float" nodename="image_anisotropy_strength" output="anisotropy_rotation_out" />
  </gltf_pbr>
  <!-- Generated material: MAT_Lamp_Metal -->
