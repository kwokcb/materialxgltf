<?xml version="1.0"?>
<materialx version="1.39" doc=" Copyright 2022-2026: Bernard Kwok. gltTF 2.0 to MTLX 1.39 generator (https://github.com/kwokcb/materialxgltf). glTF generator: pygltflib@v1.16.5. glTF version: 2.0.">
  <!-- Generated shader: gltf_pbr_surfaceshader -->
  <gltf_pbr name="gltf_pbr_surfaceshader" type="surfaceshader" nodedef="ND_gltf_pbr_surfaceshader">
    <input name="base_color" type="color3" nodename="image_base_color" output="outcolor" />
    <input name="alpha" type="float" value="0.5" />
    <input name="metallic" type="float" nodename="multiply_metallic" />
    <input name="roughness" type="float" nodename="multiply_roughness" />
    <input name="occlusion" type="float" nodename="extract_occlusion" />
  </gltf_pbr>
  <!-- Generated material: MAT_gltf_pbr_surfaceshader -->
  <surfacematerial name="MAT_gltf_pbr_surfaceshader" type="material">
